// Copy to Local.xcconfig (untracked) and fill in your own values.
// scripts/sign.sh reads these; nothing here is ever committed.
// Your Team ID: developer.apple.com/account -> Membership details.
// IDENTITY: the exact name `security find-identity -v -p codesigning` prints.
TEAM_ID = ABCDE12345
IDENTITY = Developer ID Application: Your Name (ABCDE12345)
